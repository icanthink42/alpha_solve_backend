[Unit]
Description=Alpha Solve WebSocket Server
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/alpha-solve
ExecStart=/opt/alpha-solve/alpha_solve_server
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alpha-solve

# Environment variables (add any needed here)
# Environment="PORT=8080"

[Install]
WantedBy=multi-user.target

