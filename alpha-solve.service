[Unit]
Description=Alpha Solve WebSocket Server
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/alpha-solve
ExecStart=/opt/alpha-solve/alpha_solve_server
Restart=always
RestartSec=10

# Allow binding to port 80 without root
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alpha-solve

# Environment variables
# Load from environment file (not tracked in git)
EnvironmentFile=/opt/alpha-solve/.env
Environment="PORT=80"

[Install]
WantedBy=multi-user.target

